{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visual/1.0.0/schema.json",
  "name": "SalesByRegion",
  "position": {
    "x": 440,
    "y": 160,
    "z": 1003,
    "width": 400,
    "height": 260,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
